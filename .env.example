SF511_API_KEY=
EXA_API_KEY=
NEON_AI_GATEWAY_TOKEN=
# Bare branch gateway HTTPS host, without /v1.
NEON_AI_GATEWAY_BASE_URL=
# Generate a personal account key with npm run account. Use it on each device.
FOGLINE_ACCOUNT_TOKEN=

# Optional: pooled Neon connection string enables Postgres storage; otherwise uses a local file.
DATABASE_URL=
# Neon API key. The Cursor MCP can use browser sign-in instead.
NEON_API_KEY=

# Optional services. Push delivery is enabled when NTFY_TOPIC is set.
AGENTMAIL_API_KEY=
FLY_API_TOKEN=
NTFY_SERVER=https://ntfy.sh
# Use a long random topic; anyone who knows an unprotected topic can read/publish.
NTFY_TOPIC=
# Optional bearer token for a protected ntfy topic.
NTFY_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# Skipped for the demo.
KERNEL_API_KEY=
EXECUTOR_API_KEY=
# Optional Neon gateway model override; use an ID from the branch catalog.
NEON_AI_MODEL=gemini-3-flash
